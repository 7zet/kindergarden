# Nusxa oling: cp .env.example .env
SECRET_KEY=bu-yerga-uzun-tasodifiy-satr
DJANGO_DEBUG=False
ALLOWED_HOSTS=bogcha.uz,www.bogcha.uz
CSRF_TRUSTED_ORIGINS=https://bogcha.uz
SECURE_SSL_REDIRECT=True

# PostgreSQL majburiy. Kuchli, alohida parol ishlating.
DB_NAME=bogcha
DB_USER=bogcha
DB_PASSWORD=bu-yerga-kamida-32-belgili-tasodifiy-parol
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require
COOKIE_SECURE=True

TIME_ZONE=Asia/Tashkent
PAGE_SIZE=50
APP_VERSION=1.5.0

# Telegram ota-onalar boti
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://bogcha.uz
TELEGRAM_MINI_APP_URL=https://bogcha.uz/telegram/mini/
TELEGRAM_STAFF_APP_URL=https://bogcha.uz/telegram/staff/

# Ishonchli fon vazifalari va Telegram xabar navbati
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Xatolar monitoringi (ixtiyoriy, productionda tavsiya etiladi)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
